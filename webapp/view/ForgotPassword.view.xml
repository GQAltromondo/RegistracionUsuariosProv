<mvc:View
  controllerName="sacde.RegistracionUsuariosProv.controller.ForgotPassword"
  xmlns="sap.m"
  xmlns:mvc="sap.ui.core.mvc"
  displayBlock="true">

  <!--Usamos el mismo fondo azul del login -->  
  <Page
    showNavButton="true"
    navButtonPress="onNavBack"
    class="registrationBackground fullHeight">

    <content>
      <FlexBox
        justifyContent="Center"
        alignItems="Center"
        direction="Column"
        width="100%"
        height="100%">

        <!--Caja blanca -->
        <VBox width="400px"
              class="sapUiMediumMargin loginBox">
 	<Image src="img/logosacde.png" width="115px"/>
          <Text wrapping="true"
                text="Ingresá tu correo y te enviaremos un enlace para restablecer tu contraseña." class="text-white"/>

          <Input id="emailForgot"
                 type="Email"
                 placeholder="Correo electrónico"
                 required="true"
                 class="sapUiSmallMarginTop"/>

          <Button text="Enviar enlace"
                  type="Emphasized"
                  press="onSendReset"
                  class="sapUiSmallMarginTop"/>

        </VBox>
      </FlexBox>
    </content>
  </Page>
</mvc:View>
