<mvc:View
  controllerName="sacde.RegistracionUsuariosProv.controller.ResetPassword"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  displayBlock="true">
  
  <Page title="Restablecer Contraseña"  class="registrationBackground fullHeight">
    <content>
    	 <FlexBox
        justifyContent="Center"
        alignItems="Center"
        direction="Column"
        width="100%"
        height="100%">
      <VBox  width="400px"
              class="sapUiMediumMargin loginBox ">
      	 	<Image src="img/logosacde.png" width="115px"/>
        <Text text="Ingrese su nueva contraseña." class="text-white"/>
        
        <Input
          id="newPassword"
          type="Password"
          placeholder="Nueva contraseña"
          required="true"
        />
        
        <Input
          id="confirmPassword"
          type="Password"
          placeholder="Confirmar nueva contraseña"
          required="true"
        />

        <Button
          text="Cambiar Contraseña"
          press="onChangePassword"
          type="Emphasized"
        />

        <MessageStrip
          id="messageStrip"
          visible="false"
          type="Success"
          showCloseButton="true"
        />
      </VBox>
      </FlexBox>
    </content>
  </Page>
</mvc:View>
