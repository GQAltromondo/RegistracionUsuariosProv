<mvc:View controllerName="sacde.RegistracionUsuariosProv.controller.TilesView" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m"
	displayBlock="true" xmlns:core="sap.ui.core">
	<Page id="tilesPage" class="loginBackground" showNavButton="true" navButtonPress="onNavBack">
		<content>
			<VBox justifyContent="Center" alignItems="Center" height="100%">
				<Image src="img/logosacde.png" width="115px"/>
				<VBox width="50%" class="sapUiSmallMarginEnd">
					<Label text="Seleccione la sociedad" labelFor="inputNIT"/>
					<ComboBox id="cuitComboBox" items="{ path: '/cuitsAsociados', templateShareable: true }" selectionChange="onCuitChange" width="100%"
						placeholder="Selecciona un CUIT" selectedItem="">
						<core:Item key="{key}" text="{= ${key} + ' - ' + ${text} }"/>
					</ComboBox>
				</VBox>
				<HBox width="700px" height="300px" justifyContent="SpaceBetween" alignItems="Center">
					<GenericTile  id="tileUsuarios" header="Creacion de Usuarios" press="onTileCreateUserPress" visible ="false">
						<TileContent>
							<ImageContent src="sap-icon://add-employee"/>
						</TileContent>
					</GenericTile>
				
					<GenericTile id="tilePortal" header="Portal Proveedores" press="onTilePortalPress" visible="false">
						<TileContent>
							<ImageContent src="sap-icon://world"/>
						</TileContent>
					</GenericTile>
						<GenericTile id="tileRegProvee" header="Registracion de Proveedores" press="onTileRegProvee" visible ="false">
						<TileContent>
							<ImageContent src="sap-icon://world"/> 
						</TileContent>
					</GenericTile>
				</HBox>
			</VBox>
		</content>
	</Page>
</mvc:View>