<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog
        id="newSocietyDialog"
        title="Agregar Sociedad"
        contentWidth="420px"
       >

        <content>
            <VBox  class="fragmSociedad-container"  >
            	<VBox class="fragmSociedad-content">
                <Label text="CUIT" labelFor="newSocCuitInput" />
                <Input
                    id="newSocCuitInput"
                    maxLength="11"
                    liveChange=".onNewSocietyCuitLiveChange"
                    required="true" />

                <Label text="Razón Social" labelFor="newSocRazonInput" />
                <Input
                    id="newSocRazonInput"
                    maxLength="80"  
                    required="true" />
            </VBox>
            </VBox>
        </content>

        <beginButton>
            <Button text="Guardar" type="Emphasized" press=".onNewSocietySave" />
        </beginButton>

        <endButton>
            <Button text="Cancelar" press=".onNewSocietyCancel" />
        </endButton>

    </Dialog>
</core:FragmentDefinition>
